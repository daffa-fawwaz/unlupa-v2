# ==============================================================================
# Unlupa v2 - Production Environment Configuration Template
# Salin file ini menjadi .env pada direktori deployment di VPS:
#   cp .env.production.example .env
#   chmod 600 .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Konfigurasi Aplikasi & Jaringan Host
# ------------------------------------------------------------------------------
NODE_ENV=production
APP_URL=https://unlupa.id

# Port host VPS yang diekspos secara lokal ke 127.0.0.1 untuk Nginx reverse proxy.
# PENTING: Jangan gunakan port 3000, 3002, 5432, 5433, 5434, atau 8000 karena sudah dipakai layanan lain.
APP_PORT=3005

# ------------------------------------------------------------------------------
# 2. Database PostgreSQL Khusus Unlupa v2 (Isolated Container)
# ------------------------------------------------------------------------------
POSTGRES_DB=unlupa
POSTGRES_USER=unlupa_user

# Wajib diisi dengan password acak alfanumerik yang kuat.
# CATATAN PENTING: Gunakan karakter alfanumerik (hex) agar tidak mengandung karakter pemisah URL
# seperti '@', ':', atau '/' yang dapat merusak format DATABASE_URL.
# Rekomendasi pembuat password: openssl rand -hex 24
POSTGRES_PASSWORD=ganti_dengan_password_acak_hex_minimal_32_karakter

# ------------------------------------------------------------------------------
# 3. Autentikasi Internal & JWT
# ------------------------------------------------------------------------------
# Wajib diisi minimal 32 karakter acak (misal hasil dari: openssl rand -hex 32)
JWT_SECRET=ganti_dengan_jwt_secret_acak_minimal_32_karakter_rahasia
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. Google Gemini AI (Pembuat Flashcard Otomatis & Analisis Hafalan)
# ------------------------------------------------------------------------------
# Dapatkan API key dari Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 5. Firebase Authentication & Firebase Admin
# ------------------------------------------------------------------------------
# ID proyek Firebase untuk verifikasi token autentikasi Google/Email
FIREBASE_PROJECT_ID=
VITE_FIREBASE_PROJECT_ID=

# ------------------------------------------------------------------------------
# 6. Hak Akses Superadmin Bootstrap
# ------------------------------------------------------------------------------
# Email pengguna yang otomatis mendapatkan hak Super Admin saat pertama kali login.
# Pisahkan dengan koma jika lebih dari satu (contoh: admin@unlupa.id,super@unlupa.id)
BOOTSTRAP_ADMIN_EMAILS=

# ------------------------------------------------------------------------------
# 7. Penyimpanan Cloud Supabase Storage (Opsional)
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=unlupa-storage
